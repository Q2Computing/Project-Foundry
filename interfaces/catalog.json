{
  "schema": "q2.interface-catalog.v1",
  "note": "Public interface contracts to compete against. Each entry is a generic, standards-grounded I/O contract and metric, NOT a Q2 implementation. Mission-specific physical devices (sensors, emitters) and integrated mission ICs are never listed here.",
  "metric": {
    "fields": [
      "area_um2",
      "delay_ns",
      "energy_j",
      "n_bits"
    ],
    "ranking": "information-entropy-normalized efficiency (see WITNESS.md); submit via the witness rail, design stays private (hash-only)."
  },
  "standards": {
    "pdk": "SkyWater sky130 (open-source, Apache-2.0); functions/ports from the PDK Liberty.",
    "ieee754": "IEEE 754-2019, binary32 (1 sign / 8 exponent / 23 significand), roundTiesToEven default.",
    "ocp_mx": "OCP Microscaling Formats (MX) Specification v1.0; E2M1 elements, K=32 block, shared E8M0 scale."
  },
